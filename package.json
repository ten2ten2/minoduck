{
  "name": "minoduck",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.8.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "typecheck": "pnpm --filter './apps/*' typecheck",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "check:locales": "node scripts/check-locales.mjs",
    "test": "node --test scripts/*.test.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm check:locales && pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "@nuxt/eslint-config": "1.17.0",
    "eslint": "10.10.0",
    "eslint-plugin-vuejs-accessibility": "2.6.0",
    "prettier": "3.9.6"
  }
}
