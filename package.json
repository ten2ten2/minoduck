{
  "name": "minoduck",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=26.8.2"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' dev",
    "build": "pnpm --filter './apps/*' build",
    "typecheck": "pnpm --filter './apps/*' typecheck",
    "format:check": "prettier --check .",
    "lint": "node scripts/lint-source.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:locales": "node scripts/check-locales.mjs",
    "test": "node --test scripts/*.test.mjs",
    "verify": "pnpm format:check && pnpm lint && pnpm check:a11y && pnpm check:locales && pnpm test && pnpm typecheck && pnpm build"
  },
  "devDependencies": {
    "prettier": "3.9.6"
  }
}
