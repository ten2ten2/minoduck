APP_ENV=development
PORT=8080
APP_URL=http://localhost:3001
DATABASE_URL=postgres://minoduck_app:local-only-password@localhost:5432/minoduck?sslmode=disable
MIGRATION_DATABASE_URL=postgres://minoduck_migrator:local-migration-password@localhost:5432/minoduck?sslmode=disable
BFF_SERVICE_TOKEN=local-development-service-token-change-for-production
# Generate with: openssl rand -base64 32
PROVIDER_ENCRYPTION_MASTER_KEY=
PROVIDER_KEY_ID=v1
STORAGE_DIR=./tmp/objects
# Production requires private R2. Local development can use STORAGE_DIR.
R2_ENDPOINT=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Without Resend, development returns a one-time login link in the API response.
RESEND_API_KEY=
MAIL_FROM=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_TEAM_MONTHLY=
STRIPE_PRICE_TEAM_YEARLY=
# Portal must disable subscription changes; changes use the application endpoints.
STRIPE_PORTAL_CONFIGURATION=
# Live Stripe is rejected in production until legal review is explicitly approved.
LEGAL_RELEASE_APPROVED=false
LEGAL_ENTITY_NAME=
LEGAL_CONTACT_EMAIL=
LEGAL_TERMS_EFFECTIVE_DATE=
LEGAL_PRIVACY_EFFECTIVE_DATE=
